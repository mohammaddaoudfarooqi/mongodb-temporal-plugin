# Example environment file for the deploy stack.
# deploy.sh writes its own .env on every run — this file is here so
# operators can see what overrides are available.
#
# ---- Platform guidance --------------------------------------------------
#
# macOS / Windows (Docker Desktop):
#   Use local MongoDB ONLY. Docker Desktop runs a hidden VM whose NAT
#   bridge corrupts long-lived TCP connections to external hosts.
#   Atlas will cause "incomplete read of message header" errors and
#   workflow task timeouts.
#
# Linux (native Docker):
#   Both local MongoDB and Atlas work reliably.
#
# ---- Container image built by deploy.sh ---------------------------------
PLUGIN_IMAGE_TAG=temporal-mongodb-plugin:local

# ---- Self-hosted Mongo (default) ----------------------------------------
# deploy.sh writes this URI when invoked without --atlas.
# NOTE: Do NOT add directConnection=true — it is incompatible with
# replicaSet= in the MongoDB Go driver v2.
TEMPORAL_MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
TEMPORAL_VISIBILITY_MODE=aggregation

# ---- MongoDB Atlas mode (Linux only) ------------------------------------
# Override the two vars above when calling deploy.sh --atlas '<URI>'.
# Do NOT set socketTimeoutMs in the URI or in development.yaml — the
# MongoDB Go driver v2 CSOT feature converts context cancellations into
# destructive mid-read interruptions ("incomplete read of message header").
# TEMPORAL_MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# TEMPORAL_VISIBILITY_MODE=atlas-search

# ---- Host port overrides (auto-picked when not set) ---------------------
# deploy.sh auto-detects free ports starting at the defaults below.
# Set these to pin specific ports, or leave blank to let deploy.sh pick.
# MONGO_HOST_PORT=27017
# TEMPORAL_GRPC_PORT=7233
# TEMPORAL_HTTP_PORT=7243
# TEMPORAL_UI_PORT=8080

# ---- Namespace auto-registration ----------------------------------------
# Comma-separated list of namespaces to register after startup.
# The first namespace also becomes the default for the Temporal UI.
# TEMPORAL_NAMESPACES=my-namespace
# TEMPORAL_UI_DEFAULT_NAMESPACE=my-namespace
