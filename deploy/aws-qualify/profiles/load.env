# Test knobs for the load suite. Not secrets.
SHARDS=512
VISIBILITY_MODE=atlas-search
LADDER=50,100,200,400,800
STEP_DURATION=3m
MAX_P99=10s
MAX_ERROR_RATE=0.01
LOAD_FRACTION=70          # sustained phases run at this % of the ladder maximum
FAILOVER_DURATION=10m
FAILOVER_AT=120
NODE_LOSS_DURATION=8m
NODE_LOSS_STOP_AT=120
NODE_LOSS_RESTART_AT=300
SOAK=2h                   # --soak overrides; 0 skips the phase
REQUIRED_PHASES="smoke ladder failover node-loss soak"

# Network: the functional and load runs can be up together, so their
# VPC ranges must not overlap.
VPC_CIDR=10.41.0.0/16
SUBNET_CIDR=10.41.1.0/24
