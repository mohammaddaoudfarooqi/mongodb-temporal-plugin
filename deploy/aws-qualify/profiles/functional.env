# Test knobs for the functional suite. Not secrets.
SHARDS=64
FAILOVER_CONCURRENCY=20
FAILOVER_DURATION=8m
FAILOVER_AT=90            # seconds into the failover load
SANITY_LOAD=500
SANITY_CONCURRENCY=20
SOAK=0
REQUIRED_PHASES="smoke-aggregation smoke-atlas-search atlas-gates failover sanity-load"

# Network: the functional and load runs can be up together, so their
# VPC ranges must not overlap.
VPC_CIDR=10.40.0.0/16
SUBNET_CIDR=10.40.1.0/24
