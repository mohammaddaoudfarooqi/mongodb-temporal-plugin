# Credentials for deploy/aws-qualify. Copy to .env (gitignored) and fill
# in the values after '='. The file is read as plain KEY=VALUE lines,
# never executed. qualify.sh never prints these values or puts them on
# a command line.

# Atlas: a PROJECT-level API key with the Project Owner role on the
# project below. The cluster, peering, access list entry and database
# user are created and deleted inside it; the project itself is never
# created or deleted.
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=

# AWS: set AWS_PROFILE to a named CLI profile, OR the access keys
# (AWS_SESSION_TOKEN only for temporary keys). Leave the others empty.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Owner tag on the AWS resources and the Atlas cluster.
OWNER_EMAIL=

# SSH key pair for the hosts; the public key is imported per run.
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# SSH sources for the hosts. ADMIN_CIDR is your public IP as a /32
# (detected automatically when empty). ADMIN_CIDRS adds more ranges,
# e.g. your organisation's egress ranges, separated by commas. Keep them here,
# not in the repo.
ADMIN_CIDR=
ADMIN_CIDRS=
